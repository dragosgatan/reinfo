# Copy this to .env.prod and fill in all values before deploying.
# .env.prod is gitignored — never commit real secrets.

# --- PostgreSQL (used by both the db container and DATABASE_URL below) ---
POSTGRES_USER=reinfo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=reinfo

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://reinfo:CHANGE_ME_STRONG_PASSWORD@db:5432/reinfo
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
ALLOWED_ORIGINS=["https://reinfo.dev","https://www.reinfo.dev"]
DATA_DIR=/data
ENVIRONMENT=production
PISTON_URL=http://piston:2000

# --- Sentry (optional — leave blank to disable error tracking) ---
SENTRY_DSN=
